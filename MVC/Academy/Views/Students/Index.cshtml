<div class="paginator">
    <table class="table">
        <thead>
            <tr>
                <th>
                    @*    <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]">@Html.DisplayNameFor(model => model.LastName)</a> *@
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]">Last Name</a>
                </th>
                <th>
                    @*   @Html.DisplayNameFor(model => model.FirstName) *@

                    First Name
                </th>
               @*  <th> *@
                    @*     <a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParam"]">@Html.DisplayNameFor(model => model.EnrollmentDate)</a> *@
                    @* <a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParam"]">EnrollmentDate</a> *@
               @*  </th> *@
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.last_name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.first_name)
                    </td>
                    @* <td>
                        @Html.DisplayFor(modelItem => item.EnrollmentDate)
                    </td> *@
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.stud_id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.stud_id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.stud_id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@{
    string prevDisable = Model.HasPreviousPage ? "" : "disabled";
    string nextDisable = Model.HasNextPage ? "" : "disabled";

}

<div class="pagination-controls">
    <a asp-action="Index"
       asp-route-pageNumber="@(Model.PageIndex - 1)"
       asp-route-currentFilter="@ViewData["CurrentFilter"]"
       class="btn btn-default @prevDisable">
        Previous

    </a>
    <div class="pages">
        @for (int i = 0; i < Model.TotalPages; i++)
        {
                @if (i + 1 == Model.PageIndex)
                {
                        <a asp-action="Index" asp-route-pageNumber="@(i+1)" class="page current-page">
                         @(i + 1)
                    </a>
                }
                else
                {
                        <a asp-action="Index" asp-route-pageNumber="@(i+1)" class="page">
                            @(i + 1)
                        </a>
                }
        }
    </div>

    <a asp-action="Index"
       asp-route-pageNumber="@(Model.PageIndex + 1)"
       asp-route-currentFilter="@ViewData["CurrentFilter"]"
       class="btn btn-default @nextDisable">
        Next

    </a>
</div>



